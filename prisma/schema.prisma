  @@index([tenantId, locationId], map: "idx_pos_inbound_batches_tenant_location")
  @@map("pos_inbound_batches")
}

model PosEvent {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @map("tenant_id")
  locationId      String @map("location_id")
  posConnectionId String @map("pos_connection_id") @db.Uuid

  eventType   String  @map("event_type")
