model PosConnection {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id")
  locationId String @map("location_id")

  provider         String  @default("verifone_ruby_ci") @map("provider")
  siteName         String  @map("site_name")
  serviceId        String  @map("service_id")
  externalSiteId   String  @map("external_site_id")
  connectionMode   String  @default("file_xml") @map("connection_mode")
  commanderRelease String? @map("commander_release")
  notes            String?

  isEnabled      Boolean @default(true) @map("is_enabled")
  disabledReason String? @map("disabled_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by")

  mappings        PosMapping[] 
  outboundBatches PosOutboundBatch[]
  inboundBatches  PosInboundBatch[]
  events          PosEvent[]

  @@unique([tenantId, locationId])
  @@index([tenantId, locationId], map: "idx_pos_connections_tenant_location")
  @@map("pos_connections")
}

model PosMapping {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @map("tenant_id")
  locationId      String @map("location_id")
  posConnectionId String @map("pos_connection_id") @db.Uuid

  internalEntityType  String  @map("internal_entity_type")
  internalEntityId    String  @map("internal_entity_id")
  externalEntityType  String  @map("external_entity_type")
  externalEntityKey   String  @map("external_entity_key")
  externalParentKey   String? @map("external_parent_key")
  externalDisplayName String? @map("external_display_name")

  status     String  @default("unresolved") @map("status")
  isRequired Boolean @default(true) @map("is_required")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by")

  posConnection PosConnection @relation(fields: [posConnectionId], references: [id])

  @@unique([posConnectionId, internalEntityType, internalEntityId])
  @@index([tenantId, locationId], map: "idx_pos_mappings_tenant_location")
  @@index([posConnectionId, status], map: "idx_pos_mappings_connection_status")
  @@map("pos_mappings")
}

model PosOutboundBatch {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @map("tenant_id")
  locationId      String @map("location_id")
  posConnectionId String @map("pos_connection_id") @db.Uuid

  status       String    @default("pending") @map("status")
