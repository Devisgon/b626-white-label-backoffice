  items         PosOutboundBatchItem[]

  @@index([tenantId, locationId], map: "idx_pos_outbound_batches_tenant_location")
  @@map("pos_outbound_batches")
}

model PosOutboundBatchItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
